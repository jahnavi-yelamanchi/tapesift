{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make smoke)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pyright *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(uv add *)",
      "Bash(modal run *)",
      "Bash(modal deploy *)",
      "Bash(vastai *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(uv publish *)",
      "Bash(hf upload *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
